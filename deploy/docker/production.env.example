# Generate a URL-safe value once, for example with openssl rand -hex 32.
POSTGRES_PASSWORD=
# Compose fills in the password from the line above. Change it only to use another database.
OPENBOT_DATABASE_URL=postgres://openbot:${POSTGRES_PASSWORD}@postgres:5432/openbot
# Keys that encrypt the secrets in the database. Give every instance the same keys.
# Make one with: echo "k1:$(openssl rand -hex 32)". Keep it stable with the database.
# To change keys, put the new key first and keep the old key after it.
OPENBOT_SECRET_KEYS=
# A separate shared secret for private node calls. Make one with openssl rand -hex 32.
OPENBOT_CLUSTER_SECRET=
# Loopback port published for the reverse proxy.
OPENBOT_PUBLISHED_PORT=8080
# OpenBot blocks outbound connections to private addresses. List the exact
# hosts or IP ranges to open, such as an internal model server. Empty is safest.
OPENBOT_OUTBOUND_ALLOW=

# Every other setting lives in the database. After the first start, run the
# setup program once. See the Deploy page in the docs.

# Public HTTPS origin of the Protocol Test service and the browser origins it accepts.
PROTOCOL_TEST_PUBLIC_ORIGIN=https://protocol-test.example.com
PROTOCOL_TEST_ALLOWED_ORIGINS=https://protocol-test.example.com
