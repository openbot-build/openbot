# Generate a URL-safe value once, for example with openssl rand -hex 32.
POSTGRES_PASSWORD=
# Compose fills in the password from the line above. Change it only to use another database.
OPENBOT_DATABASE_URL=postgres://openbot:${POSTGRES_PASSWORD}@postgres:5432/openbot
# Canonical HTTPS origin of the API; terminate TLS in front of OpenBot.
OPENBOT_PUBLIC_ORIGIN=https://api.example.com
# OpenID Connect provider that signs users in; register
# https://api.example.com/auth/callback as the client's redirect URI.
OPENBOT_OIDC_ISSUER=https://id.example.com
OPENBOT_OIDC_CLIENT_ID=
# Leave empty for a public PKCE client.
OPENBOT_OIDC_CLIENT_SECRET=
# Generate an independent secret once and retain it across deployments.
BETTER_AUTH_SECRET=
# Generate once with openssl rand -hex 32; keep it stable with the database.
OPENBOT_APP_ENCRYPTION_KEY=
# Loopback port published for the reverse proxy.
OPENBOT_PUBLISHED_PORT=8080

# Optional production model; set all three fields together.
OPENBOT_MODEL_ENDPOINT=
OPENBOT_MODEL_API_KEY=
OPENBOT_MODEL_ID=

# Public HTTPS origin of the Protocol Test service and the browser origins it accepts.
PROTOCOL_TEST_PUBLIC_ORIGIN=https://protocol-test.example.com
PROTOCOL_TEST_ALLOWED_ORIGINS=https://protocol-test.example.com
