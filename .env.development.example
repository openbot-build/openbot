# Development uses a local account by default (OPENBOT_DEV_MODE=1).
# With OPENBOT_DEV_MODE=0, sign in through an OpenID Connect provider instead;
# register https://localhost:8443/auth/callback as its redirect URI.
OPENBOT_DEV_MODE=1
OPENBOT_OIDC_ISSUER=
OPENBOT_OIDC_CLIENT_ID=
# Leave empty for a public PKCE client; set only for a confidential client.
OPENBOT_OIDC_CLIENT_SECRET=
# dev:setup generates this value once. Keep it stable across restarts.
BETTER_AUTH_SECRET=
OPENBOT_APP_ENCRYPTION_KEY=
OPENBOT_DEV_HTTPS_PORT=8443
OPENBOT_DEV_DATABASE_PORT=5433
OPENBOT_DEV_DATABASE_NAME=openbot
# Override the derived local connection when using another server or credentials.
# OPENBOT_DATABASE_URL=postgres://openbot_dev:openbot_dev@127.0.0.1:5433/openbot
