# The development entry signs everyone in to one local account. It writes the
# platform settings itself, so it needs no sign-in provider.
# dev:setup generates this value once. Keep it stable with the database.
OPENBOT_CLUSTER_SECRET=
OPENBOT_SECRET_KEYS=
OPENBOT_DEV_DATABASE_NAME=openbot
# devenv picks free ports for the database, the object storage, and OpenBot.
# Override the derived local connection when using another server or credentials.
# OPENBOT_DATABASE_URL=postgres://openbot_dev:openbot_dev@db.example.com:5432/openbot
# The devenv proxy serves OpenBot here. When port 80 is not free, set
# DEVENV_PROXY_LISTEN in your shell, such as 127.0.0.1:8080, and put that port
# here too.
# OPENBOT_DEV_PUBLIC_ORIGIN=http://localhost:8080
# OpenBot blocks outbound connections to private addresses. List the exact
# hosts or IP ranges to open, such as a local model server.
# OPENBOT_OUTBOUND_ALLOW=localhost
