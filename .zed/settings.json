{
	"lsp": {
		"nixd": {
			"binary": {
				"path": "devenv",
				"arguments": ["lsp"]
			}
		},
		"typescript-language-server": {
			"binary": {
				"arguments": ["--lsp", "--stdio"],
				"path": "./node_modules/typescript/bin/tsc"
			}
		}
	},
	"languages": {
		"Nix": {
			"language_servers": ["nixd", "!nil"]
		},
		"TypeScript": {
			"language_servers": [
				"typescript-language-server",
				"!typescript-ls",
				"!vtsls"
			]
		},
		"TSX": {
			"language_servers": [
				"typescript-language-server",
				"!typescript-ls",
				"!vtsls"
			]
		}
	}
}
