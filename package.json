{
	"name": "@openbot-build/workspace",
	"license": "AGPL-3.0-only",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"devDependencies": {
		"@effect/platform-node": "4.0.7",
		"@effect/tsgo": "0.56.0",
		"@openbot-build/cli": "workspace:*",
		"@openbot-build/openbot": "workspace:*",
		"@types/node": "26.6.5",
		"acorn": "8.19.0",
		"drizzle-kit": "1.0.0-rc.5",
		"effect": "4.0.7",
		"tsdown": "0.23.1",
		"typescript": "7",
		"vitest": "5.0.5"
	},
	"scripts": {
		"dev": "devenv up",
		"dev:setup": "dev-setup",
		"typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit && tsc -p scripts/tsconfig.json --noEmit && pnpm rules",
		"rules": "node --disable-warning=ExperimentalWarning scripts/effect-rules.ts",
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"build": "pnpm -r build",
		"images": "docker buildx bake -f deploy/docker/docker-bake.hcl --load",
		"images:check": "bash deploy/docker/check.sh",
		"test": "vitest run",
		"test:e2e": "pnpm --filter @openbot-build/e2e test",
		"packages:pack": "node scripts/packages.mjs pack",
		"packages:publish": "node scripts/packages.mjs publish",
		"test:packages": "node --test scripts/packages.test.mjs"
	}
}
