{
	"name": "@openbot-build/workspace",
	"license": "AGPL-3.0-only",
	"private": true,
	"packageManager": "pnpm@9.15.9",
	"type": "module",
	"devDependencies": {
		"@effect/tsgo": "0.48.1",
		"@types/node": "26.6.0",
		"acorn": "8.19.0",
		"drizzle-kit": "1.0.0-rc.5",
		"tsdown": "0.23.1",
		"typescript": "7"
	},
	"scripts": {
		"dev": "devenv up",
		"dev:setup": "dev-setup",
		"typecheck": "pnpm -r exec tsc -p tsconfig.json --noEmit",
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"build": "pnpm -r build",
		"images": "docker buildx bake -f deploy/docker/docker-bake.hcl --load",
		"images:check": "bash deploy/docker/check.sh"
	},
	"pnpm": {
		"patchedDependencies": {
			"effect@4.0.6": "patches/effect@4.0.6.patch",
			"@effect/ai-anthropic@4.0.6": "patches/@effect__ai-anthropic@4.0.6.patch",
			"@effect/ai-openai@4.0.6": "patches/@effect__ai-openai@4.0.6.patch",
			"@effect/ai-openai-compat@4.0.6": "patches/@effect__ai-openai-compat@4.0.6.patch"
		}
	}
}
