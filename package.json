{
	"name": "@nmnmcc/ability",
	"version": "0.4.0",
	"description": "Typed, composable authorization policies for Effect programs.",
	"license": "Apache-2.0",
	"type": "module",
	"packageManager": "pnpm@12.15.0",
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nmnmcc/ability.git"
	},
	"bugs": {
		"url": "https://github.com/nmnmcc/ability/issues"
	},
	"homepage": "https://github.com/nmnmcc/ability#readme",
	"files": [
		"dist",
		"src"
	],
	"exports": {
		".": "./dist/index.js",
		"./Authorizer": "./dist/Authorizer.js",
		"./Condition": "./dist/Condition.js",
		"./Decision": "./dist/Decision.js",
		"./Domain": "./dist/Domain.js",
		"./HttpApi": "./dist/HttpApi.js",
		"./Policy": "./dist/Policy.js",
		"./Principal": "./dist/Principal.js",
		"./Resource": "./dist/Resource.js",
		"./Rule": "./dist/Rule.js"
	},
	"scripts": {
		"prepare": "effect-tsgo patch --typescript --no-oxlint",
		"build": "tsdown",
		"prepack": "pnpm build",
		"prepublishOnly": "pnpm typecheck && pnpm test-types && pnpm test",
		"release:check": "pnpm typecheck && pnpm test-types && pnpm test && pnpm pack --dry-run",
		"format": "prettier . -w",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test-types": "tstyche"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"devDependencies": {
		"@effect/tsgo": "0.56.0",
		"@effect/vitest": "4.0.6",
		"@types/node": "26.6.5",
		"effect": "4.0.6",
		"prettier": "3.9.10",
		"tsdown": "0.23.1",
		"tstyche": "7.2.5",
		"typescript": "7.0.2",
		"vitest": "5.0.5"
	},
	"peerDependencies": {
		"effect": "^4.0.6"
	}
}
