{
	"name": "@openbot-build/platform",
	"version": "0.1.0",
	"type": "module",
	"description": "Headless, API-first Agent host for OpenBot",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.md",
		"migrations"
	],
	"bin": {
		"openbot-platform": "./dist/Main.js",
		"openbot-platform-migrate": "./dist/Migrate.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./StorageMigration": "./dist/database/Migrations.js",
		"./RepositoryPostgres": "./dist/sessions/RepositoryPostgres.js"
	},
	"scripts": {
		"build": "tsdown",
		"start": "node dist/Main.js",
		"start:development": "node dist/DevelopmentMain.js",
		"test": "pnpm build && tsc -p tsconfig.test.json && node --test test/*.test.ts",
		"migrate": "node dist/Migrate.js"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.8",
		"@effect/platform-node": "4.0.5",
		"@effect/sql-pg": "4.0.5",
		"@openbot-build/core": "workspace:*",
		"@openbot-build/app-host": "workspace:^",
		"@openbot-build/platform-api": "workspace:*",
		"@openbot-build/plugin-memory": "workspace:*",
		"@openbot-build/provider-openai-compat": "workspace:^",
		"@openbot-build/protocol": "workspace:*",
		"better-auth": "1.7.8",
		"drizzle-orm": "1.0.0-rc.5-5935859",
		"effect": "4.0.5",
		"jose": "6.2.12",
		"pg": "8.23.1"
	},
	"devDependencies": {
		"@openbot-build/client": "workspace:*",
		"@types/pg": "8.23.1"
	}
}
