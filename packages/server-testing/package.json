{
	"name": "@openbot-build/server-testing",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Test helpers of the OpenBot server as TypeScript source, and the tests that start a database or a whole server",
	"sideEffects": false,
	"files": [
		"test/Testing.ts",
		"test/AppFixture.ts",
		"test/BotFixture.ts",
		"test/BrowserHost.ts",
		"test/Caller.ts",
		"test/ChatTest.ts",
		"test/DefaultBot.ts",
		"test/DevelopmentLogin.ts",
		"test/Messages.ts",
		"test/OrganizationFixture.ts",
		"test/Organizations.ts",
		"test/Policies.ts",
		"test/PostgresTest.ts",
		"test/TestHost.ts",
		"test/Wait.ts",
		"test/testing"
	],
	"exports": {
		".": "./test/Testing.ts"
	},
	"scripts": {
		"build": "tsc -p tsconfig.json --noEmit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"test": "pnpm --filter \"@openbot-build/server-testing^...\" build && tsc -p tsconfig.json --noEmit && vitest run"
	},
