{
	"extends": "astro/tsconfigs/strict",
	// Leave out astro.config.ts. It imports starlight-openapi, which ships
	// TypeScript source files that do not pass strict checks. `skipLibCheck`
	// does not skip `.ts` files, only `.d.ts` files. Astro checks the config
	// when it loads it.
	"include": [".astro/types.d.ts", "scripts", "src"],
	"exclude": ["dist", "node_modules"]
}
