---
import "@fontsource-variable/dm-sans"
import "@fontsource-variable/geist"
import "../landing/landing.css"
import Scene from "../landing/Scene.astro"
import StoryVisual from "../landing/StoryVisual.astro"

const githubUrl = "https://github.com/openbot-build/openbot"
const description = "A headless, API-first Agent platform."

const startTurn = `curl -H "Authorization: Bearer $OPENBOT_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{"expected":0,"input":"Plan three days in Rome."}' \\
  https://api.example.com/v1/sessions/$SESSION/turns`

const endpoints = `POST  /v1/sessions
POST  /v1/sessions/:sessionId/turns
POST  /v1/sessions/:sessionId/turns/:turnId/steer
POST  /v1/sessions/:sessionId/turns/:turnId/interrupt
GET   /v1/sessions/:sessionId/wait
POST  /v1/sessions/:sessionId/queue
GET   /v1/apps/discover`

const scenarios = [
	{
		id: "script",
		label: "A script",
		prompt: "Every morning, read the new support tickets and sort them.",
		meaning: "Call one endpoint from a cron job. Read the answer as JSON.",
	},
	{
		id: "service",
		label: "A service",
		prompt: "Check each new order and flag the ones that look wrong.",
		meaning:
			"Your server starts a Turn. Then it reads a stream or waits with a long poll.",
	},
	{
		id: "bot",
		label: "A chat bot",
		prompt: "Answer questions in our team chat. Ask me before you send email.",
		meaning: "Risky tool calls wait until a person says yes.",
	},
]

const features = [
	{
		title: "Sessions and Memory",
		text: "Work happens in Sessions and Turns. Memory keeps versions, so you can go back and try again.",
	},
	{
		title: "Approvals",
		text: "Risky tool calls wait until a person says yes. Every answer keeps its history.",
	},
	{
		title: "Open Apps",
		text: "Agents find and use Apps that publishers put on the open web with the OpenBot App Protocol.",
	},
	{
		title: "Your models",
		text: "Use OpenAI, Anthropic, or any server that speaks Chat Completions.",
	},
]

const steps = [
	{
		title: "Start the server",
		text: "Run OpenBot on your computer with Docker and devenv. It comes with a test account and test models.",
	},
	{
		title: "Make an API key",
		text: "Sign in once in a browser, make a key, and call the API from any program.",
	},
	{
		title: "Start a Turn",
		text: "Send work in plain language. Read the answer, the tool calls, and the history.",
	},
]
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="description" content={description} />
		<title>OpenBot</title>
		<link rel="canonical" href={new URL("/", Astro.site)} />
		<script is:inline>
			// Use the theme that the docs theme picker saved, if there is one.
			try {
				const theme = localStorage.getItem("starlight-theme")
				if (theme === "light" || theme === "dark") {
					document.documentElement.dataset.theme = theme
				}
			} catch {}
		</script>
	</head>
	<body class="landing">
		<main class="home-page">
			<header class="site-header">
				<a class="project-brand" href="/">OpenBot</a>
				<nav class="site-tools" aria-label="Site">
					<a href="/docs/">Docs</a>
					<a href="/docs/api/">API</a>
					<a href={githubUrl}>GitHub</a>
				</nav>
			</header>
			<div class="page-content">
				<div class="product-landing marketing-story">
					<Scene class="campaign-hero kay-opening">
						<div class="hero-title">
							<h1>
								<span>Agents you can call.</span>
								<span>Results you can check.</span>
							</h1>
						</div>
						<div class="hero-aside">
							<p>
								OpenBot is an open source Agent platform with no user interface.
								You give work to an Agent over HTTP.
							</p>
							<p class="hero-links">
								<a href="/docs/quickstart/">Quick start</a>
								<a href="/docs/api/">API reference</a>
							</p>
						</div>
						<StoryVisual label="Start a Turn" tone="hero" code={startTurn} />
					</Scene>

					<Scene class="kay-scenarios" aria-labelledby="scenario-title">
						<h2 id="scenario-title">What will you build?</h2>
						<div class="connection-story">
							<div class="perspective-switch" role="group" aria-label="Clients">
								{
									scenarios.map((scenario, index) => (
										<button
											type="button"
											data-scenario={scenario.id}
											aria-pressed={index === 0 ? "true" : "false"}
											aria-controls={`scenario-${scenario.id}`}
										>
											{scenario.label}
										</button>
									))
								}
							</div>
							{
								scenarios.map((scenario, index) => (
									<div
										id={`scenario-${scenario.id}`}
										class="connection-perspective"
										data-scenario={scenario.id}
										aria-hidden={index === 0 ? "false" : "true"}
										inert={index !== 0}
									>
										<blockquote>{scenario.prompt}</blockquote>
										<div class="scenario-meaning">
											<h3>{scenario.meaning}</h3>
										</div>
									</div>
								))
							}
						</div>
					</Scene>

					<Scene class="campaign-proof" aria-labelledby="contract-title">
						<StoryVisual label="One contract" tone="proof" code={endpoints} />
						<div>
							<h2 id="contract-title">
								Every feature is an HTTP call.
								<br />
								One typed contract.
							</h2>
							<p>
								The server, the TypeScript client, and the API reference all
								come from one contract. Use an API key from any program.
							</p>
						</div>
					</Scene>

					<Scene class="resource-horizons" aria-labelledby="features-title">
						<h2 id="features-title">
							Bring your own client. <span>Keep people in control.</span>
						</h2>
						<div class="horizon-notes">
							{
								features.map((feature) => (
									<article>
										<h3>{feature.title}</h3>
										<p>{feature.text}</p>
									</article>
								))
							}
						</div>
					</Scene>

					<Scene class="closing-scene" aria-labelledby="closing-title">
						<div class="closing-atmosphere" aria-hidden="true"></div>
						<h2 id="closing-title">
							<span>Start in</span> <span>three steps.</span>
						</h2>
						<ol class="inline-usage" aria-label="Steps">
							{
								steps.map((step) => (
									<li>
										<h3>{step.title}</h3>
										<p>{step.text}</p>
									</li>
								))
							}
						</ol>
					</Scene>

					<aside class="kay-builder" aria-label="License">
						<p>
							OpenBot is free software under AGPL-3.0-only. You can read the
							code, change it, and run it on your own servers.
						</p>
						<a href={githubUrl}>Read the code</a>
					</aside>
					<footer class="landing-footer">
						<span>OpenBot</span>
						<a href="/docs/">Docs</a>
					</footer>
				</div>
			</div>
		</main>
		<script>
			// Show the scenario of the button that the reader picks.
			document.addEventListener("click", (event) => {
				const button =
					event.target instanceof Element
						? event.target.closest<HTMLButtonElement>("button[data-scenario]")
						: null
				const story = button?.closest(".connection-story")
				if (button === null || button === undefined || story === null || story === undefined) return
				const current = button.dataset["scenario"]
				story
					.querySelectorAll<HTMLButtonElement>("button[data-scenario]")
					.forEach((option) => {
						option.setAttribute("aria-pressed", String(option === button))
					})
				story
					.querySelectorAll<HTMLElement>(".connection-perspective")
					.forEach((panel) => {
						const hidden = panel.dataset["scenario"] !== current
						panel.inert = hidden
						panel.setAttribute("aria-hidden", String(hidden))
					})
			})
		</script>
	</body>
</html>
