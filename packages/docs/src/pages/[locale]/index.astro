---
import type { GetStaticPaths } from "astro"
import { type HomeLocale, homeLocales } from "../../i18n.ts"
import Home from "../../landing/Home.astro"

// The home page in every language except English, such as `/de/`.
export const getStaticPaths = (() =>
	homeLocales
		.filter((locale) => locale.path !== "")
		.map((locale) => ({
			params: { locale: locale.path },
			props: { locale },
		}))) satisfies GetStaticPaths

interface Props {
	locale: HomeLocale
}

const { locale } = Astro.props
---

<Home locale={locale} />
