---
// Takes the place of a photo: a soft color field with a code card on top.
interface Props {
	label: string
	tone: "hero" | "proof"
	code: string
}

const { label, tone, code } = Astro.props
---

<figure class={`story-photo story-visual story-visual-${tone}`}>
	<pre><code>{code}</code></pre>
	<figcaption class="photo-credit">{label}</figcaption>
</figure>
