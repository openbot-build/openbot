{
	"name": "@openbot-build/model-providers",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "The model providers of the OpenBot server: OpenAI, OpenAI-compatible services, Anthropic, ChatGPT, and TypeSafe",
