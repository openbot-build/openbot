		"./providers/chatgpt/ChatGptProvider": "./dist/providers/chatgpt/ChatGptProvider.js",
		"./providers/chatgpt/OAuth": "./dist/providers/chatgpt/OAuth.js",
		"./providers/openai-compat/OpenAiCompatProvider": "./dist/providers/openai-compat/OpenAiCompatProvider.js",
		"./providers/openai/OpenAiProvider": "./dist/providers/openai/OpenAiProvider.js",
		"./providers/openai/OpenAiRealtime": "./dist/providers/openai/OpenAiRealtime.js",
		"./providers/openai/Request": "./dist/providers/openai/Request.js",
		"./providers/openai/ResponsesCompaction": "./dist/providers/openai/ResponsesCompaction.js",
		"./providers/typesafe/TypeSafeProvider": "./dist/providers/typesafe/TypeSafeProvider.js"
