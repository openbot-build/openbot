{
	"name": "@openbot-build/server-kernel",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "The parts of the OpenBot server that every plugin shares: errors, secrets, settings, configuration, network rules, background work, and the HTTP host",
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"exports": {
		"./DomainControl": "./dist/DomainControl.js",
		"./AuthConfiguration": "./dist/AuthConfiguration.js",
		"./AuthModel": "./dist/AuthModel.js",
		"./Configuration": "./dist/Configuration.js",
		"./EnvironmentConfiguration": "./dist/EnvironmentConfiguration.js",
		"./InstanceSettings": "./dist/InstanceSettings.js",
		"./SecretFiles": "./dist/SecretFiles.js",
		"./DatabaseError": "./dist/DatabaseError.js",
		"./Failures": "./dist/Failures.js",
		"./HttpBoundary": "./dist/HttpBoundary.js",
		"./HttpHost": "./dist/HttpHost.js",
		"./Records": "./dist/Records.js",
		"./Report": "./dist/Report.js",
		"./Reporting": "./dist/Reporting.js",
		"./Snapshot": "./dist/Snapshot.js",
		"./Background": "./dist/Background.js",
		"./OutboundGuard": "./dist/OutboundGuard.js",
		"./OutboundPolicy": "./dist/OutboundPolicy.js",
		"./Compare": "./dist/Compare.js",
		"./Secrets": "./dist/Secrets.js",
		"./Documents": "./dist/Documents.js",
		"./Platform": "./dist/Platform.js",
		"./Settings": "./dist/Settings.js",
		"./SettingsPostgres": "./dist/SettingsPostgres.js",
		"./Views": "./dist/Views.js"
	},
	"scripts": {
		"build": "tsdown",
		"test": "pnpm build && tsc -p tsconfig.test.json && vitest run"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.2",
		"@effect/sql-pg": "4.1.2",
		"@nmnmcc/ability": "3.2.0",
		"@openbot-build/api": "workspace:*",
		"@openbot-build/core": "workspace:*",
		"@openbot-build/domain": "workspace:*",
		"@openbot-build/protocol": "workspace:*",
		"@openbot-build/server-database": "workspace:*",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "4.1.2",
		"undici": "8.12.3"
	},
	"devDependencies": {
		"@effect/vitest": "4.1.2",
		"vitest": "5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openbot-build/openbot.git",
		"directory": "packages/server-kernel"
	}
}
