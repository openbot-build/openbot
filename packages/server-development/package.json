{
	"name": "@openbot-build/server-development",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"private": true,
	"type": "module",
	"description": "The OpenBot development server, with a local test account, simulated models and a simulated App",
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"exports": {
		"./Development": "./dist/Development.js",
		"./DevelopmentAppUi": "./dist/DevelopmentAppUi.js",
		"./DevelopmentApps": "./dist/DevelopmentApps.js",
		"./DevelopmentBusiness": "./dist/DevelopmentBusiness.js",
		"./DevelopmentModel": "./dist/DevelopmentModel.js",
		"./DevelopmentScenarios": "./dist/DevelopmentScenarios.js"
	},
	"scripts": {
		"build": "tsdown",
		"start": "node dist/DevelopmentMain.js",
		"test": "pnpm build && tsc -p tsconfig.test.json && vitest run"
	},
	"dependencies": {
		"@effect/platform-node": "4.1.2",
		"@effect/sql-pg": "4.1.2",
		"@openbot-build/api": "workspace:*",
