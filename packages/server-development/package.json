		"@openbot-build/plugin-files": "workspace:*",
		"@openbot-build/plugin-models": "workspace:*",
		"@openbot-build/plugin-platform": "workspace:*",
		"@openbot-build/plugin-triggers": "workspace:*",
		"@openbot-build/plugin-vaults": "workspace:*",
		"@openbot-build/plugin-work": "workspace:*",
