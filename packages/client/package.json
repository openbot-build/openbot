{
	"name": "@openbot-build/client",
	"version": "0.1.0",
	"license": "MIT",
	"type": "module",
	"description": "Typed client for the OpenBot API",
	"sideEffects": false,
	"exports": {
		".": "./dist/index.js",
		"./Api": "./dist/Api.js",
		"./Core": "./dist/Core.js"
	},
	"files": [
		"dist",
		"LICENSE"
	],
	"scripts": {
		"build": "tsdown",
		"test": "tsc -p tsconfig.test.json && vitest run",
		"prepack": "tsdown --config tsdown.bundle.config.ts",
		"postpack": "pnpm build"
	},
	"dependencies": {
		"effect": "4.0.7",
		"@modelcontextprotocol/client": "2.3.1",
		"@nmnmcc/ability": "3.1.0",
		"@modelcontextprotocol/ext-apps": "2.0.3"
	},
	"devDependencies": {
		"@effect/vitest": "4.0.7",
		"vitest": "5.0.5",
		"@openbot-build/api": "workspace:*",
		"@openbot-build/protocol": "workspace:*",
		"@openbot-build/domain": "workspace:*",
		"@openbot-build/core": "workspace:*"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/openbot-build/openbot.git",
		"directory": "packages/client"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	}
}
