{
	"name": "@openbot-build/openbot",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Headless, API-first Bot host for OpenBot",
	"sideEffects": false,
	"files": [
		"dist",
		"src"
	],
	"bin": {
		"openbot-server": "./dist/Main.js",
		"openbot-migrate": "./dist/Migrate.js",
		"openbot-setup": "./dist/Setup.js",
		"openbot-inspect": "./dist/Inspect.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./Parts": "./dist/Parts.js"
	},
	"scripts": {
		"build": "tsdown",
		"start": "node dist/Main.js",
		"test": "pnpm build && tsc -p tsconfig.test.json && vitest run",
		"migrate": "node dist/Migrate.js",
		"setup": "node dist/Setup.js"
	},
