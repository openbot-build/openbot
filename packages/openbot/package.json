{
	"name": "@openbot-build/openbot",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Headless, API-first Bot host for OpenBot",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.md",
		"migrations",
		"test/Testing.ts",
		"test/AppFixture.ts",
		"test/BotFixture.ts",
		"test/BrowserHost.ts",
		"test/Caller.ts",
		"test/ChatTest.ts",
		"test/DefaultBot.ts",
		"test/DevelopmentLogin.ts",
		"test/Messages.ts",
		"test/OrganizationFixture.ts",
		"test/Organizations.ts",
		"test/Policies.ts",
		"test/PostgresTest.ts",
		"test/TestHost.ts",
		"test/Wait.ts",
		"test/testing"
	],
	"bin": {
		"openbot-server": "./dist/Main.js",
		"openbot-migrate": "./dist/Migrate.js",
		"openbot-setup": "./dist/Setup.js",
		"openbot-inspect": "./dist/Inspect.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./Development": "./dist/Development.js",
		"./StorageMigration": "./dist/server-upgrade/Migrations.js",
		"./testing": "./test/Testing.ts"
	},
	"scripts": {
		"build": "tsdown",
		"start": "node dist/Main.js",
		"start:development": "node dist/DevelopmentMain.js",
		"test": "pnpm build && tsc -p tsconfig.test.json && vitest run",
		"migrate": "node dist/Migrate.js",
		"setup": "node dist/Setup.js"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.8",
