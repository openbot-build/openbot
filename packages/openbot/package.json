{
	"name": "@openbot-build/openbot",
	"version": "0.1.0",
	"license": "AGPL-3.0-only",
	"type": "module",
	"description": "Headless, API-first Agent host for OpenBot",
	"sideEffects": false,
	"files": [
		"dist",
		"src",
		"README.md",
		"migrations"
	],
	"bin": {
		"openbot": "./dist/Main.js",
		"openbot-migrate": "./dist/Migrate.js",
		"openbot-setup": "./dist/Setup.js"
	},
	"exports": {
		".": "./dist/index.js",
		"./StorageMigration": "./dist/database/Migrations.js",
		"./Development": "./dist/Development.js"
	},
	"scripts": {
		"build": "tsdown",
		"start": "node dist/Main.js",
		"start:development": "node dist/DevelopmentMain.js",
		"test": "pnpm build && tsc -p tsconfig.test.json && node --test test/*.test.ts",
		"migrate": "node dist/Migrate.js",
		"setup": "node dist/Setup.js"
	},
	"dependencies": {
		"@better-auth/drizzle-adapter": "1.7.8",
		"@effect/ai-anthropic": "4.0.5",
		"@effect/ai-openai": "4.0.5",
		"@effect/ai-openai-compat": "4.0.5",
		"@effect/ai-typesafe": "4.0.5",
		"@effect/platform-node": "4.0.5",
		"@effect/sql-pg": "4.0.5",
		"@jitl/quickjs-singlefile-mjs-release-sync": "0.32.0",
		"@openbot-build/api": "workspace:*",
		"@openbot-build/core": "workspace:*",
		"@openbot-build/protocol": "workspace:*",
		"better-auth": "1.7.8",
		"drizzle-orm": "1.0.0-rc.5",
		"effect": "4.0.5",
		"jose": "6.2.12",
		"pg": "8.23.1",
		"quickjs-emscripten-core": "0.32.0"
	},
	"devDependencies": {
		"@openbot-build/client": "workspace:*",
		"@types/pg": "8.23.1"
	}
}
