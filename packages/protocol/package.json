		"./AppConnections": "./dist/connections/AppConnections.js",
		"./Authorization": "./dist/connections/Authorization.js",
		"./Client": "./dist/connections/Client.js",
		"./McpClient": "./dist/connections/McpClient.js",
		"./MemoryStore": "./dist/connections/MemoryStore.js",
		"./OAuthAuthorization": "./dist/connections/OAuthAuthorization.js",
		"./Store": "./dist/connections/Store.js",
		"./CatalogDiscovery": "./dist/discovery/CatalogDiscovery.js",
		"./Discovery": "./dist/discovery/Discovery.js",
