# Run the lifecycle scripts of the workspace packages one at a time. The root
# and packages/ability both run `effect-tsgo patch` in `prepare`, and both patch
# the same tsc file in node_modules. When two patches run at the same time, one
# moves the file while the other moves it too, and `pnpm install` fails. One
# patch after the other is safe, because the second one sees that the file has
# the patch already.
child-concurrency=1
